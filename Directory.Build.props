<Project>

  <PropertyGroup Label="Identidad del proyecto">
    <Authors>Jose Francisco Cruz Corro</Authors>
    <Company>Jose Francisco Cruz Corro</Company>
    <Product>Banco · Arquitectura de microservicios</Product>
    <Copyright>Copyright (c) 2026 Jose Francisco Cruz Corro</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
