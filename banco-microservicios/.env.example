# Copie este archivo a .env y ajuste los valores antes de desplegar.
# docker compose lo lee automáticamente.

# Clave de firma de los tokens de sesión. Debe tener al menos 32 caracteres y ser la MISMA en
# los dos microservicios: es lo que permite que un token emitido por Clientes valga en Cuentas.
# En producción debe venir de un almacén de secretos, nunca de un archivo versionado.
JWT_CLAVE=cambie-esta-clave-por-una-de-al-menos-32-caracteres
